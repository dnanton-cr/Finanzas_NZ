rules_version = '2';

// ⚠️  PUBLICAR SOLO DESPUÉS DE completar la activación (ver docs/SEGURIDAD.md):
//     1) habilitar Email/Password en Authentication y crear los usuarios,
//     2) crear un doc por usuario en `usuarios/{uid}` con su rol,
//     3) poner SEGURIDAD_ACTIVA = true en index.html y desplegar.
// Si publicás estas reglas antes, la web queda sin acceso (exige login y
// todavía no habría usuarios/perfiles creados).

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function perfilExiste() {
      return autenticado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function rol() {
      return perfilExiste()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol
        : null;
    }
    function esAdmin() { return perfilExiste() && rol() == 'admin'; }

    // Perfiles: cada usuario lee el suyo; solo un admin crea/edita/borra.
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // Datos financieros: leen todos los usuarios con sesión; escriben solo los admin.
    match /transacciones/{id} { allow read: if autenticado(); allow write: if esAdmin(); }
    match /ingresos/{id}      { allow read: if autenticado(); allow write: if esAdmin(); }
    match /estados/{id}       { allow read: if autenticado(); allow write: if esAdmin(); }
    match /presupuesto/{id}   { allow read: if autenticado(); allow write: if esAdmin(); }
    match /config/{id}        { allow read: if autenticado(); allow write: if esAdmin(); }

    // Cualquier otra ruta: cerrada.
    match /{document=**} { allow read, write: if false; }
  }
}
