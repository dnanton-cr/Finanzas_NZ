rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ PRIVACIDAD: estas reglas permiten LECTURA y ESCRITURA públicas
    // (cualquiera que conozca el projectId puede leer o escribir).
    // Es lo más simple para que el dashboard funcione sin login, incluida la
    // subida de estados de cuenta desde el propio HTML.
    //
    // Para cerrarlo, usa Firebase Auth (ver README.md):
    //   allow read, write: if request.auth != null;
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
